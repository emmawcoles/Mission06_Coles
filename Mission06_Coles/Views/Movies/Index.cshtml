@model IEnumerable<Mission06_Coles.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<!--
    Index View
    Displays the full list of movies in Joel Hilton's collection.
    Uses a Bootstrap-styled table to show movie information and provides
    links to Edit, Details, and Delete each movie.
-->

<h1 class="mb-4">Movie List</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Search movies by title..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Year)</th>
                <th>@Html.DisplayNameFor(model => model.Director)</th>
                <th>@Html.DisplayNameFor(model => model.Rating)</th>
                <th>@Html.DisplayNameFor(model => model.Edited)</th>
                <th>@Html.DisplayNameFor(model => model.LentTo)</th>
                <th>@Html.DisplayNameFor(model => model.Notes)</th>
                <th>@Html.DisplayNameFor(model => model.CopiedToPlex)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@Html.DisplayFor(modelItem => item.Year)</td>
                    <td>@Html.DisplayFor(modelItem => item.Director)</td>
                    <td>@Html.DisplayFor(modelItem => item.Rating)</td>
                    <td>@Html.DisplayFor(modelItem => item.Edited)</td>
                    <td>@Html.DisplayFor(modelItem => item.LentTo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Notes)</td>
                    <td>@Html.DisplayFor(modelItem => item.CopiedToPlex)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MovieId" class="btn btn-sm btn-secondary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.MovieId" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.MovieId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Create" class="btn btn-primary mt-2">Add New Movie</a>
