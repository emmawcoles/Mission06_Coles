@model Mission06_Coles.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<!--
    Details View
    Displays all stored information for a single movie
    from Joel Hilton's collection.
-->

<h1>Details</h1>

<div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Year)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Year)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Director)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Director)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Rating)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Rating)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Edited)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Edited)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LentTo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.LentTo)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Notes)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CopiedToPlex)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CopiedToPlex)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MovieId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>